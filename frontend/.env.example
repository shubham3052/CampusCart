# ==============================================================================
# Smart Student Stationery Delivery System - Frontend Environment Template
# COPY THIS FILE TO frontend/.env FOR LOCAL OR STAGING/PRODUCTION BUILDS
# ==============================================================================

# Backend REST API Base URL
# Local Development: http://127.0.0.1:8000/api
# Production Deployment: https://your-backend-domain.example.com/api
VITE_API_BASE_URL=https://your-backend-domain.example.com/api

# Google Maps Platform Browser API Key
# Required APIs: Maps JavaScript API, Places API, Geocoding API, Directions API
# Configure HTTP referrer restrictions in Google Cloud Console for security
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

