# ==============================================================================
# Smart Student Stationery Delivery System (CampusCart) - Git Ignore Configuration
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
*/venv/
*/.venv/
backend/venv/
backend/env/
*.joblib
*.pkl

# Sensitive Environment Configurations (Never commit secrets)
.env
.env.*
*.env
!.env.example
!**/.env.example

# Secrets & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ecdsa*
id_ed25519*

# Node.js & Frontend Build Outputs
node_modules/
*/node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
build/
frontend/build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Cache Files
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
local_db_dump.sql
*.sql.gz
*.sql.dump

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS Temporary Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Test-Generated Temporary Files & Coverage
.pytest_cache/
.coverage
htmlcov/
*.tmp
temp/
scratch/

# User Uploaded Documents & Media (Preserve directory structure via .gitkeep)
media/documents/*
!media/documents/.gitkeep
media/products/*
!media/products/.gitkeep
media/temp/*
!media/temp/.gitkeep

# Production Static Files & Logs
staticfiles/
backend/staticfiles/
logs/
backend/logs/
*.log

