# ==============================================================================
# Smart Student Stationery Delivery System - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS
# DO NOT COMMIT SENSITIVE PASSWORDS OR PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
# Set DEBUG=False in production deployment
DEBUG=True

# In production, provide a cryptographically random string (min 50 chars)
SECRET_KEY=replace-with-production-secret

# Comma-separated list of fully qualified domain names and IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,api.smartstationery.campus.edu

# ------------------------------------------------------------------------------
# 2. Production SSL & HTTPS Security (Step 26)
# ------------------------------------------------------------------------------
# Set to True in production to enforce HTTPS redirects and secure cookies
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_PROTO=False

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend web application origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://smartstationery.campus.edu

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://smartstationery.campus.edu

# ------------------------------------------------------------------------------
# 4. MySQL 8.0 Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# 5. Media & File Upload Storage
# ------------------------------------------------------------------------------
MEDIA_ROOT=../media/

# ------------------------------------------------------------------------------
# 6. Payment Gateway Configuration (Step 25)
# ------------------------------------------------------------------------------
# Supported providers: SANDBOX, RAZORPAY, STRIPE
PAYMENT_GATEWAY=SANDBOX
PAYMENT_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_KEY_SECRET=rzp_test_placeholder_key_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret
PAYMENT_CURRENCY=INR

# ------------------------------------------------------------------------------
# 7. HTTPS Transactional Email API (Port 443 HTTPS - Recommended for Cloud/Render)
# Priority: BREVO_API_KEY > RESEND_API_KEY > Django EMAIL_BACKEND fallback
# ------------------------------------------------------------------------------

# 7a. Brevo (Sendinblue) HTTPS API (RECOMMENDED - sends to ANY recipient on free tier)
# Get your free API key at https://app.brevo.com (300 free emails/day)
# Communicates over HTTPS port 443, bypassing cloud host SMTP port blocks (25/465/587).
# Set BREVO_API_KEY in your production environment variables (e.g. Render dashboard).
# The DEFAULT_FROM_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your-verified-brevo-sender@gmail.com
BREVO_SENDER_NAME=CampusCart
DEFAULT_FROM_EMAIL=your-verified-brevo-sender@gmail.com
DEFAULT_FROM_NAME=CampusCart

# 7b. Resend HTTPS API (Legacy fallback - only sends to account owner without custom domain)
# Get your free API key at https://resend.com (3,000 free emails/month)
# Communicates over HTTPS port 443, bypassing cloud host SMTP port blocks (25/465/587).
# Set RESEND_API_KEY in Render Environment Variables.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=CampusCart

# ------------------------------------------------------------------------------
# 7b. Legacy Gmail SMTP Configuration (Optional fallback for localhost)
# ------------------------------------------------------------------------------
# To deliver OTPs via SMTP in local development:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: Go to Security -> 2-Step Verification -> App Passwords
# 3. Create a new App Password named "CampusCart" (generates a 16-character code)
# 4. Paste your Gmail address into EMAIL_HOST_USER and the 16-character code into EMAIL_HOST_PASSWORD
# 5. Note: When EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are set, Django automatically uses smtp.EmailBackend.
#    To test offline without sending real emails, leave EMAIL_HOST_USER empty to output OTPs to the terminal.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=your-email@example.com
EMAIL_TIMEOUT=15

# ------------------------------------------------------------------------------
# 8. Email OTP Verification Security Policy (Step 26A)
# ------------------------------------------------------------------------------
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_RESENDS_PER_HOUR=5

# ------------------------------------------------------------------------------
# 9. Printing Document Retention Policy (Step 26)
# ------------------------------------------------------------------------------
# Documents for completed/cancelled jobs are eligible for automated purge after N days
PRINT_DOCUMENT_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 10. GPS Location & Courier Tracking Policy (Step 15 & 26)
# ------------------------------------------------------------------------------
LOCATION_RETENTION_DAYS=7
MAX_LOCATION_SPEED_KMH=80.0

# ------------------------------------------------------------------------------
# 11. Google Maps Platform Services (Location Foundation)
# ------------------------------------------------------------------------------
# Server-side key for Geocoding / Distance / Directions if invoked via backend
# Restrict this key to server IP addresses in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_backend_api_key_here

